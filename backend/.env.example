# ── Google Gemini ─────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
